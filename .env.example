# Hermes in Chrome environment example
#
# Copy this file to ~/.hermes/.env or your local backend environment.
# Never commit real API keys.

# DeepSeek
DEEPSEEK_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_API_KEY=
GEMINI_API_KEY=

# xAI Grok
XAI_API_KEY=

# Alibaba DashScope / Qwen
DASHSCOPE_API_KEY=

# Kimi / Moonshot
KIMI_API_KEY=

# Z.ai / GLM
GLM_API_KEY=
ZAI_API_KEY=

# MiniMax
MINIMAX_API_KEY=

# Optional custom OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=
